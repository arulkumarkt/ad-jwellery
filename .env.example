# ─── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/covering-jewellery

# ─── Auth ──────────────────────────────────────────────────
# Long random string used to sign session JWTs (openssl rand -base64 48)
NEXTAUTH_SECRET=

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Image storage ─────────────────────────────────────────
# IMAGE_STORAGE_PROVIDER: "local" (writes to /public/uploads), "cloudinary" or "imagekit"
IMAGE_STORAGE_PROVIDER=local
# For cloudinary: https://api.cloudinary.com/v1_1/<cloud-name>/image/upload
IMAGE_STORAGE_URL=
# For cloudinary: "<api_key>:<api_secret>"; for imagekit: the private key (URL can stay empty)
IMAGE_STORAGE_API_KEY=
# Optional extra remote image hostnames, comma separated (for next/image)
NEXT_PUBLIC_IMAGE_HOSTS=

# ─── Payments (Razorpay) ───────────────────────────────────
# Leave empty to run with Cash on Delivery only
PAYMENT_SECRET_KEY=
NEXT_PUBLIC_PAYMENT_KEY=

# ─── Seed ──────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@swarnika.in
SEED_ADMIN_PASSWORD=ChangeMe@123
# https://imagekit.io/dashboard/change-plan